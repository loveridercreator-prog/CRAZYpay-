<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvUpiValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="saloni.pay@okaxis"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHolderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Saloni P2P Pro"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvUpiType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="UPI VPA"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnToggleActive"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_badge_active"
        android:paddingHorizontal="12dp"
        android:text="ACTIVE"
        android:textAllCaps="false"
        android:textColor="@color/success_green"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
