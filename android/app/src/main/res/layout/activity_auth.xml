<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App Brand Logo & Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="CrazyPay"
            android:textColor="@color/text_white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tagline"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- Auth Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tab Switcher: Login / Register -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/bg_input"
                android:orientation="horizontal"
                android:padding="3dp">

                <Button
                    android:id="@+id/tabLogin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:text="Log In"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/tabRegister"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:text="Register"
                    android:textAllCaps="false"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Phone Number Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Mobile Number"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="Enter 10-digit mobile number"
                android:inputType="phone"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_dim"
                android:textSize="14sp" />

            <!-- Password Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Password"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="Enter password"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_dim"
                android:textSize="14sp" />

            <!-- Captcha Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etCaptcha"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="Captcha"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_dim"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvCaptchaCode"
                    android:layout_width="90dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_card_secondary"
                    android:gravity="center"
                    android:letterSpacing="0.2"
                    android:text="7492"
                    android:textColor="@color/accent_cyan"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- OTP Input -->
            <LinearLayout
                android:id="@+id/otpContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etOtp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="6-Digit SMS OTP"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_dim"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSendOtp"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_badge_active"
                    android:text="Send OTP"
                    android:textAllCaps="false"
                    android:textColor="@color/success_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnAuthSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_primary"
                android:text="Log In"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Quick Demo Login Button -->
            <Button
                android:id="@+id/btnQuickDemo"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@color/transparent"
                android:text="Quick Demo Access (Skip Login)"
                android:textAllCaps="false"
                android:textColor="@color/primary_blue_light"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="Protected by DLT Telecom Shield\nZero PII Data Storage Policy"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
