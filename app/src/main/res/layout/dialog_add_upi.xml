<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bind New UPI Identifier"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Enter valid VPA or UPI Mobile Number"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/dialogEtUpiValue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="e.g. mobile@upi or username@okhdfcbank"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_dim"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/dialogEtHolderName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:hint="Bank Account Holder Full Name"
        android:inputType="textPersonName"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_dim"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/dialogCbSetActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="true"
        android:text="Set as Single Active Binding immediately"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/dialogBtnSaveUpi"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button_primary"
        android:text="Save &amp; Bind"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
